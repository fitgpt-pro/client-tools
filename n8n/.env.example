# === Required secrets — auto-generated by setup.sh (chmod 600) ===
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
POSTGRES_NON_ROOT_PASSWORD=

# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n

# === n8n image tag (stable | latest | 1.x.x) ===
N8N_VERSION=stable

# === Network ===
# N8N_PORT is the host port for plain-HTTP mode. Ignored when DOMAIN is set
# (Caddy listens on 80/443 and n8n is bound to loopback only).
N8N_PORT=5678
# N8N_PORT_BINDING is computed by setup.sh:
#   plain HTTP: "<N8N_PORT>:5678"           — exposed on 0.0.0.0
#   HTTPS:      "127.0.0.1:5678:5678"       — loopback only, Caddy is public entrypoint
N8N_PORT_BINDING=5678:5678

# === Optional: HTTPS via Caddy + Let's Encrypt ===
# Set DOMAIN to enable Caddy reverse proxy. setup.sh toggles COMPOSE_PROFILES=proxy automatically.
DOMAIN=
ACME_EMAIL=

# === Computed by setup.sh from DOMAIN ===
N8N_HOST=
N8N_PROTOCOL=
WEBHOOK_URL=
N8N_SECURE_COOKIE=

# === Timezone (IANA tz database, e.g. Europe/Moscow, UTC) ===
GENERIC_TIMEZONE=UTC
TZ=UTC

# === Telemetry & metrics ===
N8N_DIAGNOSTICS_ENABLED=false
N8N_METRICS=false

# === Compose profiles (auto-set by setup.sh; "proxy" enables Caddy) ===
COMPOSE_PROFILES=

# === Container resource limits ===
# This Postgres-backed compose is NOT sized for the reference 2 vCPU / 1.9 GB host
# (n8n + postgres together need ~1.5 GB, leaving nothing for video-editor + OS).
# Use this profile only on hosts with ≥ 4 vCPU and ≥ 4 GB RAM. On the reference
# host run `setup.sh --sqlite` instead — see README and n8n/.env.sqlite.example.
N8N_CPUS_LIMIT=1.5
N8N_MEM_LIMIT=1g
N8N_MEM_RESERVATION=256m

POSTGRES_CPUS_LIMIT=0.5
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=128m
