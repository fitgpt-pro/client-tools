# === Required secrets — auto-generated by setup.sh (chmod 600) ===
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
POSTGRES_NON_ROOT_PASSWORD=

# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n

# === n8n image tag (stable | latest | 1.x.x) ===
N8N_VERSION=stable

# === Network ===
# Used in plain-HTTP mode. Ignored when DOMAIN is set (Caddy listens on 80/443).
N8N_PORT=5678

# === Optional: HTTPS via Caddy + Let's Encrypt ===
# Set DOMAIN to enable Caddy reverse proxy. setup.sh toggles COMPOSE_PROFILES=proxy automatically.
DOMAIN=
ACME_EMAIL=

# === Computed by setup.sh from DOMAIN ===
N8N_HOST=
N8N_PROTOCOL=
WEBHOOK_URL=
N8N_SECURE_COOKIE=

# === Timezone (IANA tz database, e.g. Europe/Moscow, UTC) ===
GENERIC_TIMEZONE=UTC
TZ=UTC

# === Telemetry & metrics ===
N8N_DIAGNOSTICS_ENABLED=false
N8N_METRICS=false

# === Compose profiles (auto-set by setup.sh; "proxy" enables Caddy) ===
COMPOSE_PROFILES=

# === Container resource limits (sized for a 4 vCPU / 8 GB host shared with video-editor) ===
N8N_CPUS_LIMIT=1.5
N8N_MEM_LIMIT=1g
N8N_MEM_RESERVATION=256m

POSTGRES_CPUS_LIMIT=0.5
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=128m
