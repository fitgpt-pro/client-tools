    {
      "parameters": {
        "jsCode": "const appTitle = $('➡️ Запустить из другого workflow').first().json.app_title || '';\n\nconst thumbnailLink = $('🎲 Случайный выбор видео').first().json.thumbnailLink;\nlet videoPreviewLink = '';\nif (thumbnailLink) {\n  const paramIndex = thumbnailLink.lastIndexOf('=');\n  if (paramIndex !== -1) {\n    videoPreviewLink = thumbnailLink.substring(0, paramIndex);\n  }\n}\n\nreturn [{\n  json: {\n    text: $input.first().json.text,\n    appTitle: appTitle,\n    videoPreviewLink: videoPreviewLink\n  }\n}];"
