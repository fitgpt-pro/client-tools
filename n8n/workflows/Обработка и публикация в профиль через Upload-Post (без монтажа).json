        "jsCode": "// Оба LLM-узла (с превью и без) уже объединены через Merge-ноду.\n// Используем $input напрямую — не обращаемся к ненужным нодам.\nconst llmOutput = $input.first().json.output;\n\nconst title = llmOutput.title;\nconst appTitle = $('📱 Подготовить название видео').first().json.appTitle;\nconst description = llmOutput.description;\n\nlet extendedTitle = title;\nif (appTitle && !title.includes(appTitle)) {\n  extendedTitle = `${title} | ${appTitle}`;\n}\n\nlet extendedDescription = description;\n\nconst promocode = $('➡️ Запустить из другого workflow').first().json.promocode;\nif (promocode) {\n  const language = $('➡️ Запустить из другого workflow').first().json.language;\n  switch (language.toLowerCase()) {\n    case 'русский':\n      extendedTitle += `. Промокод: ${promocode}`;\n      break;\n    default:\n      extendedTitle += `. Promocode: ${promocode}`;\n      break;\n  }\n}\n\nconst filename = `${$now.toFormat('yyyy-MM-dd-hh-mm-ss')}.mp4`;\n\nreturn [{\n  json: {\n    title: extendedTitle,\n    description: extendedDescription,\n    filename: filename,\n  }\n}];"
      },
