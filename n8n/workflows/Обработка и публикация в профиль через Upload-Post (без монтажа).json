              "message": "=You generate titles and descriptions for social media video publications.\nYour gender: {{ $('➡️ Запустить из другого workflow').item.json.gender }}.\nWrite the answer using the following language: {{ $('➡️ Запустить из другого workflow').item.json.language }}.\n\n{{ $('➡️ Запустить из другого workflow').item.json.description_system_prompt }}"
            }
          ]
        },
