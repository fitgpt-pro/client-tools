    {
      "parameters": {
        "jsCode": "const currentHour = DateTime.now().setZone('Europe/Moscow').hour;\n\nconst filtered = [];\n\nfor (const item of $input.all()) {\n  const {\n    'ID папки очередь Google Drive': drive_folder_id,\n    'ID папки архив Google Drive': published_folder_id,\n    'Instagram': up_profile_instagram,\n    'TikTok': up_profile_tiktok,\n    'YouTube': up_profile_youtube,\n    'Часы публикации': scheduleRaw,\n  } = item.json;\n\n  // Проверка обязательных полей\n  if (!drive_folder_id || !published_folder_id || !(up_profile_instagram || up_profile_tiktok || up_profile_youtube)) {\n    continue;\n  }\n\n  // Проверка расписания\n  if (!scheduleRaw || typeof scheduleRaw !== 'string') {\n    continue;\n  }\n\n  const hours = scheduleRaw\n    .split(',')\n    .map(h => parseInt(h.trim(), 10))\n    .filter(h => !isNaN(h) && h >= 0 && h <= 23);\n\n  if (hours.length === 0) {\n    continue;\n  }\n\n  if (hours.includes(currentHour)) {\n    filtered.push(item);\n  }\n}\n\nreturn filtered;"
      },
