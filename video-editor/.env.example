# === Secrets — set these before first run ===
# Generate ADMIN_TOKEN and METRICS_TOKEN with: openssl rand -hex 32
ADMIN_TOKEN=
METRICS_TOKEN=
OPENAI_API_KEY=

# === Port ===
PORT=8002

# === Database ===
DB_PATH=/app/data/api_keys.db

# === Logging ===
LOG_JSON=true
LOG_LEVEL=INFO
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# === FFmpeg & job queue (minimal tier: 2 CPU / 2 GB RAM) ===
FFMPEG_MAX_CONCURRENT=1
FFMPEG_THREADS=2
FFMPEG_TIMEOUT=540
JOB_QUEUE_MAX_SIZE=5
JOB_QUEUE_WORKERS=1

# === Gunicorn (WEB_CONCURRENCY must always be 1) ===
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=600
GUNICORN_GRACEFUL_TIMEOUT=590

# === Container resource limits (minimal tier) ===
CPUS_LIMIT=2
MEM_LIMIT=1500m
MEMSWAP_LIMIT=3g
MEM_RESERVATION=256m
